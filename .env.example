# SuperviselyQC Local Daemon Configuration
# Copy to .env or export in your shell / LaunchAgent plist.

# Server binding (must remain loopback)
SLY_QC_HOST=127.0.0.1
SLY_QC_PORT=8765

# Security & CORS
# Comma-separated or JSON list of allowed Chrome extension IDs:
# SLY_QC_ALLOWED_EXTENSION_IDS=["your_extension_id_here"]
SLY_QC_ALLOW_UNPACKED_EXTENSIONS=true
# Optional custom bridge token path or explicit token:
# SLY_QC_BRIDGE_TOKEN_PATH=~/.config/supervisely-qc/bridge_token
# SLY_QC_BRIDGE_TOKEN=

# Storage & Cache Limits
# SLY_QC_CONFIG_DIR=~/.config/supervisely-qc
# SLY_QC_CACHE_DIR=~/.cache/supervisely-qc/images
# SLY_QC_MODELS_DIR=~/.cache/supervisely-qc/models
SLY_QC_MAX_DISK_CACHE_BYTES=1073741824
SLY_QC_DISK_CACHE_TTL_SECONDS=86400
SLY_QC_MAX_IMAGE_UPLOAD_BYTES=104857600
SLY_QC_MAX_RAM_IMAGES=2
SLY_QC_MAX_RAM_CACHE_BYTES=157286400

# Vision & Job Timeouts
SLY_QC_MODEL_IDLE_TTL_SECONDS=180
SLY_QC_DEEP_JOB_TIMEOUT_SECONDS=15.0
SLY_QC_LOW_RAM_STANDARD_MB=900
SLY_QC_LOW_RAM_RULES_MB=450

# Geometric & CV Rule Tunables (SLY_QC_TUNE_*)
SLY_QC_TUNE_DUPLICATE_IOU_THRESHOLD=0.90
SLY_QC_TUNE_CANVAS_WIDE_AREA_RATIO=0.90
SLY_QC_TUNE_MICRO_CLICK_MIN_SIDE_PX=15.0
SLY_QC_TUNE_MIN_RELATIVE_AREA=0.00001
SLY_QC_TUNE_BBOX_MAX_ASPECT_RATIO=16.0
SLY_QC_TUNE_POLY_COLLINEAR_TOL_PX=0.75
SLY_QC_TUNE_POLY_ACUTE_SPIKE_DEG=10.0
SLY_QC_TUNE_POLY_MICRO_HOLE_PX=16.0
SLY_QC_TUNE_BITMAP_MIN_ISLAND_PX=25
SLY_QC_TUNE_BITMAP_MAX_PINHOLE_PX=500
SLY_QC_TUNE_BITMAP_MAX_ROUGHNESS_RATIO=1.38
SLY_QC_TUNE_LINE_ACUTE_BACKTRACK_DEG=25.0
SLY_QC_TUNE_LINE_ENDPOINT_GAP_PX=35.0
SLY_QC_TUNE_SAM_LOOSE_SLACK_PX=14.0
SLY_QC_TUNE_SAM_CLIPPED_RECALL_MIN=0.88
