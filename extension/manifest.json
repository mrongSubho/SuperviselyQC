{
  "manifest_version": 3,
  "name": "Supervisely Hybrid QC Assistant",
  "version": "1.0.0",
  "description": "Non-invasive deterministic & local Apple Silicon vision QC assistant for Quantigo Supervisely labeling jobs.",
  "permissions": ["storage", "alarms", "activeTab"],
  "host_permissions": [
    "http://127.0.0.1/*",
    "https://*.supervisely.com/*"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "background": {
    "service_worker": "src/background/serviceWorker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.supervisely.com/app/images2/*",
        "https://*.supervisely.com/labeling/*",
        "http://127.0.0.1/app/images2/*",
        "http://127.0.0.1/labeling/*"
      ],
      "js": ["src/page/interceptor.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://*.supervisely.com/app/images2/*",
        "https://*.supervisely.com/labeling/*",
        "http://127.0.0.1/app/images2/*",
        "http://127.0.0.1/labeling/*"
      ],
      "js": ["src/content/index.js"],
      "run_at": "document_idle",
      "world": "ISOLATED"
    }
  ],
  "action": {
    "default_title": "Supervisely Hybrid QC Assistant",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "src/options/index.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
